    "oidc-client-ts": "^3.4.1",
    "primereact": "^10.9.2",
    "react": "^18.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.1",
    "react-oidc-context": "^3.3.0",
    "react-router-dom": "^7.18.2",
    "use-broadcast-ts": "^2.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
