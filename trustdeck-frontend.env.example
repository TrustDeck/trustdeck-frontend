# Copy this file to trustdeck-frontend.env and adjust values for your deployment.
# trustdeck-frontend.env is ignored by Git via *.env.

# Host bind for the frontend container. With a reverse proxy on the same server,
# keep this bound to localhost.
FRONTEND_BIND=127.0.0.1:8082

# Public URL used by the browser to call the TrustDeck backend through Nginx.
API_BASE_URL=https://example.org/api

# Public Keycloak/OIDC realm URL used by the browser.
AUTHORITY_URL=https://example.org/realms/development

# Public OIDC client configured in Keycloak.
AUTHORITY_CLIENT=frontend

# Redirect URLs registered in the Keycloak frontend client.
AUTHORITY_REDIRECT_URI=https://example.org/auth/callback
AUTHORITY_SILENT_URI=https://example.org/silent-renew.html

# Optional build-time proxy settings for restricted server networks.
# Uncomment and adjust if the Docker build cannot reach npmjs.org.
# http_proxy=http://proxy.example.org:8080
# https_proxy=http://proxy.example.org:8080
# no_proxy=localhost,127.0.0.1,example.org
